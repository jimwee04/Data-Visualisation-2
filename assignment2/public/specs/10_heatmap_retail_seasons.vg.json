{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Month-by-year heatmap, small multiples by food group: each month's supermarket sales compared with that financial year's monthly average (March 2020 left out of the average), July 2018 to June 2024",
  "data": {
    "url": "../data/clean/retail_monthly.csv",
    "format": {
      "parse": {
        "month": "date:'%Y-%m'",
        "grams_per_day": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "month(datum.month) >= 6 ? year(datum.month) : year(datum.month) - 1",
      "as": "fyStart"
    },
    {
      "calculate": "datum.fyStart + '-' + slice(toString(datum.fyStart + 1), 2)",
      "as": "fy"
    },
    {
      "calculate": "timeFormat(datum.month, '%b')",
      "as": "mon"
    },
    {
      "calculate": "timeFormat(datum.month, '%Y-%m') === '2020-03' ? null : datum.grams_per_day",
      "as": "baseGrams"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "baseGrams",
          "as": "fyAverage"
        }
      ],
      "groupby": [
        "group",
        "fy"
      ]
    },
    {
      "calculate": "100 * (datum.grams_per_day / datum.fyAverage - 1)",
      "as": "pct"
    },
    {
      "calculate": "abs(datum.pct) >= 10 ? (datum.pct > 0 ? '+' : '') + format(datum.pct, '.0f') : ''",
      "as": "label"
    }
  ],
  "facet": {
    "row": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Fruit",
        "Cereals (bread, flour, pasta)",
        "Vegetables",
        "Meat & poultry",
        "Milk products"
      ],
      "title": null,
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelAnchor": "start",
        "labelOrient": "top",
        "labelFontSize": 13,
        "labelFontWeight": 600,
        "labelColor": "#2F3A55",
        "labelPadding": 6
      }
    }
  },
  "spacing": 16,
  "spec": {
    "width": {
      "step": 76
    },
    "height": {
      "step": 15
    },
    "encoding": {
      "x": {
        "field": "mon",
        "type": "ordinal",
        "title": null,
        "sort": [
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec",
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun"
        ],
        "axis": {
          "orient": "bottom",
          "labelAngle": 0,
          "labelFontSize": 12,
          "labelExpr": "{'Jul':'July','Aug':'August','Sep':'September','Oct':'October','Nov':'November','Dec':'December','Jan':'January','Feb':'February','Mar':'March','Apr':'April','May':'May','Jun':'June'}[datum.value]"
        }
      },
      "y": {
        "field": "fy",
        "type": "ordinal",
        "title": null,
        "axis": {
          "labelFontSize": 12
        }
      }
    },
    "layer": [
      {
        "params": [
          {
            "name": "monthHover",
            "select": {
              "type": "point",
              "fields": [
                "mon"
              ],
              "on": "pointerover",
              "clear": "pointerout"
            }
          }
        ],
        "mark": {
          "type": "rect",
          "cornerRadius": 3,
          "strokeWidth": 2
        },
        "encoding": {
          "color": {
            "field": "pct",
            "type": "quantitative",
            "title": "Sales compared with that year's average",
            "scale": {
              "type": "threshold",
              "domain": [
                -10,
                -5,
                -2,
                2,
                5,
                10
              ],
              "range": [
                "#4B5874",
                "#8A96AE",
                "#C7CDDA",
                "#F1F1EE",
                "#F5C6A3",
                "#E9924F",
                "#BF5317"
              ]
            },
            "legend": null,
            "description": "Seven bands; the colour key is drawn in the chart header (index.html) so it sits on the title sight line."
          },
          "stroke": {
            "condition": {
              "param": "monthHover",
              "empty": false,
              "value": "#2F3A55"
            },
            "value": "#ffffff"
          },
          "tooltip": [
            {
              "field": "group",
              "type": "nominal",
              "title": "Food group"
            },
            {
              "field": "month",
              "type": "temporal",
              "title": "Month",
              "format": "%B %Y"
            },
            {
              "field": "grams_per_day",
              "type": "quantitative",
              "title": "Bought (grams per person per day)",
              "format": ".1f"
            },
            {
              "field": "fyAverage",
              "type": "quantitative",
              "title": "That year's monthly average, March 2020 left out (grams per person per day)",
              "format": ".1f"
            },
            {
              "field": "pct",
              "type": "quantitative",
              "title": "Difference (%)",
              "format": "+.1f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "fontSize": 12,
          "fontWeight": 600
        },
        "encoding": {
          "text": {
            "field": "label"
          },
          "color": {
            "condition": {
              "test": "abs(datum.pct) >= 10",
              "value": "#ffffff"
            },
            "value": "#2F3A55"
          }
        }
      }
    ]
  }
}