{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth: farm-gate food value per resident by state, 2024-25. Five classes in round steps around the national average (A$2,680), so the middle class means 'about average'; the A$1,000 break separates the Australian Capital Territory. The colour key is drawn in the chart header (index.html).",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "../data/clean/australia.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "lookup": "properties.STE_NAME21",
          "from": {
            "data": {
              "url": "../data/clean/state_per_person.csv",
              "format": {
                "parse": {
                  "food_value_m": "number",
                  "population": "number",
                  "value_per_person": "number",
                  "lon": "number",
                  "lat": "number"
                }
              }
            },
            "key": "region",
            "fields": [
              "state",
              "food_value_m",
              "population",
              "value_per_person",
              "largest_group"
            ]
          }
        },
        {
          "calculate": "datum.food_value_m / 1000",
          "as": "food_value_b"
        }
      ],
      "params": [
        {
          "name": "hoverState",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "value_per_person",
          "type": "quantitative",
          "title": "Food value per resident (A$)",
          "scale": {
            "type": "threshold",
            "domain": [
              1000,
              2500,
              3000,
              3500
            ],
            "range": [
              "#EFEAE4",
              "#D6CBBF",
              "#B3A291",
              "#857360",
              "#594A3C"
            ]
          },
          "legend": null
        },
        "strokeWidth": {
          "condition": {
            "param": "hoverState",
            "empty": false,
            "value": 3
          },
          "value": 1.5
        },
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "value_per_person",
            "type": "quantitative",
            "title": "Food value per resident",
            "format": "$,.0f"
          },
          {
            "field": "food_value_b",
            "type": "quantitative",
            "title": "Total food value (A$ billion)",
            "format": ",.1f"
          },
          {
            "field": "population",
            "type": "quantitative",
            "title": "Residents (December 2024)",
            "format": ",.0f"
          },
          {
            "field": "largest_group",
            "type": "nominal",
            "title": "Biggest food group by value"
          }
        ]
      }
    },
    {
      "description": "Leader lines from each offshore label to its state",
      "data": {
        "url": "../data/clean/state_per_person.csv",
        "format": {
          "parse": {
            "food_value_m": "number",
            "population": "number",
            "value_per_person": "number",
            "lon": "number",
            "lat": "number",
            "label_lon": "number",
            "label_lat": "number",
            "label_inside": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.label_inside === 0 || datum.state === 'ACT'"
        },
        {
          "calculate": "datum.state === 'ACT' ? 153.4 : datum.state === 'VIC' ? datum.label_lon + 1.2 : datum.label_lon - 1.6",
          "as": "fromLon"
        },
        {
          "calculate": "datum.state === 'ACT' ? -35.9 : datum.state === 'VIC' ? datum.label_lat + 1.3 : datum.label_lat + 0.2",
          "as": "fromLat"
        },
        {
          "calculate": "datum.state === 'VIC' ? 143.6 : datum.state === 'TAS' ? 147.6 : 149.1",
          "as": "toLon"
        },
        {
          "calculate": "datum.state === 'VIC' ? -37.4 : datum.state === 'TAS' ? -42.0 : -35.5",
          "as": "toLat"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#4B5569",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "fromLon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "fromLat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "toLon"
        },
        "latitude2": {
          "field": "toLat"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.1,
            "lat": -35.5
          }
        ]
      },
      "mark": {
        "type": "circle",
        "size": 30,
        "color": "#4B5569"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "../data/clean/state_per_person.csv",
        "format": {
          "parse": {
            "food_value_m": "number",
            "population": "number",
            "value_per_person": "number",
            "lon": "number",
            "lat": "number",
            "label_lon": "number",
            "label_lat": "number",
            "label_inside": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "stateName[datum.state] + '\\n' + format(datum.value_per_person, '$,.0f')",
          "as": "label"
        },
        {
          "calculate": "datum.state === 'ACT' ? 155.6 : datum.label_lon",
          "as": "labelLon"
        },
        {
          "calculate": "datum.state === 'ACT' ? -36.6 : datum.state === 'SA' ? datum.label_lat + 1.6 : datum.label_lat",
          "as": "labelLat"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15
      },
      "encoding": {
        "longitude": {
          "field": "labelLon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "labelLat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.label_inside === 1 && datum.value_per_person >= 3000",
            "value": "#ffffff"
          },
          "value": "#2F3A55"
        }
      }
    }
  ],
  "params": [
    {
      "name": "stateName",
      "expr": "{'WA': 'Western\\nAustralia', 'NT': 'Northern\\nTerritory', 'SA': 'South\\nAustralia', 'QLD': 'Queensland', 'NSW': 'New South\\nWales', 'VIC': 'Victoria', 'TAS': 'Tasmania', 'ACT': 'Australian Capital\\nTerritory'}"
    }
  ]
}