{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Diverging stacked bar: where each food group's supply goes, as a share of everything grown or imported",
  "width": "container",
  "height": 340,
  "params": [
    {
      "name": "yr",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 2010,
        "max": 2023,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "data": {
    "url": "../data/clean/fbs_groups.csv",
    "format": {
      "parse": {
        "year": "number",
        "production": "number",
        "imports": "number",
        "exports": "number",
        "domestic_use": "number",
        "kg_per_person": "number",
        "self_sufficiency": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year === yr && datum.group !== 'Vegetables'"
    },
    {
      "calculate": "datum.production + datum.imports",
      "as": "handled"
    },
    {
      "calculate": "-100 * datum.exports / datum.handled",
      "as": "Exported"
    },
    {
      "calculate": "100 * (datum.production - datum.exports) / datum.handled",
      "as": "Grown & used here"
    },
    {
      "calculate": "100 * datum.imports / datum.handled",
      "as": "Imported"
    },
    {
      "calculate": "datum.exports / datum.handled",
      "as": "exportShare"
    },
    {
      "fold": [
        "Exported",
        "Grown & used here",
        "Imported"
      ],
      "as": [
        "part",
        "pct"
      ]
    },
    {
      "calculate": "datum.part === 'Exported' ? datum.exports : datum.part === 'Imported' ? datum.imports : datum.production - datum.exports",
      "as": "kt"
    },
    {
      "calculate": "abs(datum.pct)",
      "as": "pctAbs"
    },
    {
      "calculate": "indexof(['Exported', 'Grown & used here', 'Imported'], datum.part)",
      "as": "partOrder"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.7
        },
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative",
          "stack": "zero",
          "title": "Share of all food grown or imported (%)",
          "scale": {
            "domain": [
              -100,
              100
            ]
          },
          "axis": {
            "labelExpr": "abs(datum.value) + '%'",
            "values": [
              -100,
              -75,
              -50,
              -25,
              0,
              25,
              50,
              75,
              100
            ]
          }
        },
        "color": {
          "field": "part",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Exported",
              "Grown & used here",
              "Imported"
            ],
            "range": [
              "#2F3A55",
              "#A3AEC6",
              "#C2724F"
            ]
          },
          "legend": {
            "orient": "top",
            "symbolType": "square"
          }
        },
        "order": {
          "field": "partOrder"
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Food group"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "part",
            "type": "nominal",
            "title": "Part of supply"
          },
          {
            "field": "pctAbs",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".0f"
          },
          {
            "field": "kt",
            "type": "quantitative",
            "title": "Quantity ('000 t)",
            "format": ",.0f"
          }
        ],
        "y": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "exportShare",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 12,
            "ticks": false,
            "domain": false,
            "labelPadding": 8
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#2F3A55",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": -50,
            "t": "← sent overseas"
          },
          {
            "x": 50,
            "t": "eaten or used in Australia →"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#4B5569",
        "baseline": "top",
        "dy": -14
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}