{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected scatterplot: milk produced compared with milk used in Australia each year, 2010-2023, against lines of equal self-sufficiency",
  "width": "container",
  "height": 460,
  "data": {
    "url": "../data/clean/fbs_groups.csv",
    "format": {
      "parse": {
        "year": "number",
        "production": "number",
        "imports": "number",
        "exports": "number",
        "domestic_use": "number",
        "self_sufficiency": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.group === 'Milk & dairy'"
    },
    {
      "calculate": "datum.production / 1000",
      "as": "produced"
    },
    {
      "calculate": "datum.domestic_use / 1000",
      "as": "used"
    }
  ],
  "encoding": {
    "x": {
      "field": "produced",
      "type": "quantitative",
      "title": "Milk produced in Australia (million tonnes)",
      "scale": {
        "domain": [
          7.4,
          10.4
        ],
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [
          7.5,
          8,
          8.5,
          9,
          9.5,
          10
        ],
        "format": ".1f",
        "grid": false
      }
    },
    "y": {
      "field": "used",
      "type": "quantitative",
      "title": "Milk used in Australia (million tonnes)",
      "scale": {
        "domain": [
          7.4,
          9.6
        ],
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [
          7.5,
          8,
          8.5,
          9,
          9.5
        ],
        "format": ".1f",
        "grid": false
      }
    }
  },
  "layer": [
    {
      "description": "Shortfall zone: above the 100 line, more is used than produced (same stone fill as the self-sufficiency chart)",
      "data": {
        "values": [
          {
            "produced": 7.4,
            "used": 7.4,
            "top": 9.6
          },
          {
            "produced": 10.4,
            "used": 10.4,
            "top": 9.6
          }
        ]
      },
      "mark": {
        "type": "area",
        "color": "#E7E2DE",
        "clip": true
      },
      "encoding": {
        "y2": {
          "field": "top"
        }
      }
    },
    {
      "description": "Guide lines: every point on a line grows the same kg per 100 kg used (used = produced / ratio)",
      "data": {
        "values": [
          {
            "ratio": 100,
            "produced": 7.4
          },
          {
            "ratio": 100,
            "produced": 10.4
          },
          {
            "ratio": 110,
            "produced": 7.4
          },
          {
            "ratio": 110,
            "produced": 10.4
          },
          {
            "ratio": 120,
            "produced": 7.4
          },
          {
            "ratio": 120,
            "produced": 10.4
          }
        ]
      },
      "transform": [
        {
          "calculate": "datum.produced * 100 / datum.ratio",
          "as": "used"
        }
      ],
      "mark": {
        "type": "line",
        "clip": true,
        "strokeWidth": 1
      },
      "encoding": {
        "detail": {
          "field": "ratio"
        },
        "color": {
          "condition": {
            "test": "datum.ratio === 100",
            "value": "#4B5569"
          },
          "value": "#B4B7BD"
        },
        "strokeDash": {
          "condition": {
            "test": "datum.ratio === 100",
            "value": [
              1,
              0
            ]
          },
          "value": [
            4,
            3
          ]
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "produced": 9.5,
            "used": 9.55,
            "t": "100 kg: grows only what it uses"
          },
          {
            "produced": 10.37,
            "used": 9.48,
            "t": "110 kg"
          },
          {
            "produced": 10.37,
            "used": 8.69,
            "t": "120 kg"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#4B5569",
        "align": "right",
        "baseline": "bottom"
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "produced": 7.47,
            "used": 9.52,
            "t": "Shortfall: imports must fill the gap"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 400,
        "color": "#4B5569",
        "align": "left",
        "baseline": "middle",
        "fontStyle": "italic"
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "produced": 10.33,
            "used": 7.48,
            "t": "Surplus: grows more than it uses"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 400,
        "color": "#4B5569",
        "align": "right",
        "baseline": "middle",
        "fontStyle": "italic"
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    },
    {
      "description": "The year-by-year path",
      "mark": {
        "type": "line",
        "color": "#C4C6CB",
        "strokeWidth": 2
      },
      "encoding": {
        "order": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "scale": {
            "domain": [
              2010,
              2023
            ],
            "range": [
              "#C2DBBE",
              "#1F5E26"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "format": "d",
            "values": [
              2010,
              2016,
              2023
            ],
            "gradientLength": 180
          }
        },
        "size": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 220
          },
          "value": 110
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "self_sufficiency",
            "type": "quantitative",
            "title": "kg grown for every 100 kg used",
            "format": ".0f"
          },
          {
            "field": "produced",
            "type": "quantitative",
            "title": "Produced (million tonnes)",
            "format": ".2f"
          },
          {
            "field": "used",
            "type": "quantitative",
            "title": "Used in Australia (million tonnes)",
            "format": ".2f"
          },
          {
            "field": "imports",
            "type": "quantitative",
            "title": "Imported (thousand tonnes)",
            "format": ",.0f"
          },
          {
            "field": "exports",
            "type": "quantitative",
            "title": "Exported (thousand tonnes)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "produced": 9.02,
            "used": 7.55,
            "t": "2010: 118 kg grown for every 100 kg used"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#2F3A55",
        "align": "center",
        "baseline": "top"
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      },
      "description": "Annotations on the path"
    },
    {
      "data": {
        "values": [
          {
            "produced": 9.96,
            "used": 9.23,
            "t": "2016: peak of 10.0 million tonnes produced"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#2F3A55",
        "align": "right",
        "baseline": "middle"
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "produced": 8.36,
            "used": 8.44,
            "t": "2023: 103 kg, almost no buffer left"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#2F3A55",
        "align": "right",
        "baseline": "bottom"
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    }
  ]
}