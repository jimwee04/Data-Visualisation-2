{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waterfall chart: spare milk (produced minus used in Australia) in 2010, 2016 and 2023, bridged by the change in milk produced and milk used in each period. Each total equals the previous total plus the production change minus the use change. Within each period the gain is drawn before the loss; that order is a choice, so the floating levels between totals are not real years.",
  "width": "container",
  "height": 400,
  "data": {
    "url": "../data/clean/dairy_bridge.csv",
    "format": {
      "parse": {
        "order": "number",
        "year": "number",
        "value": "number",
        "start": "number",
        "end": "number",
        "spare_pct": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "lead",
          "field": "label",
          "as": "next"
        }
      ],
      "sort": [
        {
          "field": "order"
        }
      ]
    },
    {
      "calculate": "max(datum.start, datum.end)",
      "as": "top"
    },
    {
      "calculate": "min(datum.start, datum.end)",
      "as": "bottom"
    },
    {
      "calculate": "replace(datum.label, '|', ' ')",
      "as": "step"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "y": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#4B5569",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Connectors: each bar's end level carries across to the next bar",
      "transform": [
        {
          "filter": "datum.next != null"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#8A8D93",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "sort": {
            "field": "order"
          },
          "title": null,
          "scale": {
            "paddingInner": 0.3,
            "paddingOuter": 0.15
          },
          "axis": {
            "labelExpr": "split(replace(datum.label, ' ', '|'), '|')",
            "labelAngle": 0,
            "labelPadding": 8,
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelLineHeight": 15
          },
          "bandPosition": 1
        },
        "x2": {
          "field": "next",
          "bandPosition": 0
        },
        "y": {
          "field": "end",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2.8
            ],
            "nice": false
          }
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "order"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "bar",
        "stroke": "#2F3A55"
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "sort": {
            "field": "order"
          },
          "title": null,
          "scale": {
            "paddingInner": 0.3,
            "paddingOuter": 0.15
          },
          "axis": {
            "labelExpr": "split(replace(datum.label, ' ', '|'), '|')",
            "labelAngle": 0,
            "labelPadding": 8,
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelLineHeight": 15
          }
        },
        "y": {
          "field": "start",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2.8
            ],
            "nice": false
          },
          "title": "Million tonnes",
          "axis": {
            "values": [
              0,
              0.5,
              1,
              1.5,
              2,
              2.5
            ],
            "format": ".1f",
            "grid": false
          }
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "total",
              "gain",
              "loss"
            ],
            "range": [
              "#2E7D32",
              "#9CCB9F",
              "#B4B7BD"
            ]
          },
          "legend": {
            "orient": "top",
            "symbolType": "square",
            "labelLimit": 300,
            "labelExpr": "{'total': 'Spare milk in that year', 'gain': 'Adds spare milk', 'loss': 'Takes spare milk away'}[datum.label]"
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 2
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "step",
            "title": "Step"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Million tonnes",
            "format": "+.2f"
          },
          {
            "field": "spare_pct",
            "type": "quantitative",
            "title": "Spare, as % of milk used",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "description": "Totals: amount above the share spare",
      "transform": [
        {
          "filter": "datum.kind === 'total'"
        },
        {
          "calculate": "format(datum.value, '.2f')",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#1F5E26",
        "baseline": "bottom",
        "dy": -22
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "sort": {
            "field": "order"
          },
          "title": null,
          "scale": {
            "paddingInner": 0.3,
            "paddingOuter": 0.15
          },
          "axis": {
            "labelExpr": "split(replace(datum.label, ' ', '|'), '|')",
            "labelAngle": 0,
            "labelPadding": 8,
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelLineHeight": 15
          }
        },
        "y": {
          "field": "top",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2.8
            ],
            "nice": false
          }
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind === 'total'"
        },
        {
          "calculate": "format(datum.spare_pct, '.0f') + '% spare'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#1F5E26",
        "baseline": "bottom",
        "dy": -6
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "sort": {
            "field": "order"
          },
          "title": null,
          "scale": {
            "paddingInner": 0.3,
            "paddingOuter": 0.15
          },
          "axis": {
            "labelExpr": "split(replace(datum.label, ' ', '|'), '|')",
            "labelAngle": 0,
            "labelPadding": 8,
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelLineHeight": 15
          }
        },
        "y": {
          "field": "top",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2.8
            ],
            "nice": false
          }
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "description": "Gains: label above the bar",
      "transform": [
        {
          "filter": "datum.kind === 'gain'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#2F3A55",
        "baseline": "bottom",
        "dy": -5
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "sort": {
            "field": "order"
          },
          "title": null,
          "scale": {
            "paddingInner": 0.3,
            "paddingOuter": 0.15
          },
          "axis": {
            "labelExpr": "split(replace(datum.label, ' ', '|'), '|')",
            "labelAngle": 0,
            "labelPadding": 8,
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelLineHeight": 15
          }
        },
        "y": {
          "field": "top",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2.8
            ],
            "nice": false
          }
        },
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": "+.2f"
        }
      }
    },
    {
      "description": "Losses: label below the bar",
      "transform": [
        {
          "filter": "datum.kind === 'loss'"
        },
        {
          "calculate": "'−' + format(abs(datum.value), '.2f')",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#2F3A55",
        "baseline": "top",
        "dy": 5
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "sort": {
            "field": "order"
          },
          "title": null,
          "scale": {
            "paddingInner": 0.3,
            "paddingOuter": 0.15
          },
          "axis": {
            "labelExpr": "split(replace(datum.label, ' ', '|'), '|')",
            "labelAngle": 0,
            "labelPadding": 8,
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelLineHeight": 15
          }
        },
        "y": {
          "field": "bottom",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2.8
            ],
            "nice": false
          }
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}