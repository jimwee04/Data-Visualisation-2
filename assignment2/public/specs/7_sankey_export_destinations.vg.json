{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Sankey diagram: Australia's food exports by commodity (left) and destination region (right), 2024, US$",
  "width": "container",
  "height": 480,
  "params": [
    {
      "name": "familyOf",
      "expr": "{'Beef': 'Meat', 'Lamb & mutton': 'Meat', 'Wheat': 'Grains, oilseeds & pulses', 'Barley': 'Grains, oilseeds & pulses', 'Canola': 'Grains, oilseeds & pulses', 'Pulses': 'Grains, oilseeds & pulses', 'Dairy': 'Dairy, wine & other food', 'Wine': 'Dairy, wine & other food', 'Other food': 'Dairy, wine & other food'}"
    }
  ],
  "encoding": {
    "x": {
      "type": "quantitative",
      "scale": {
        "domain": [
          -0.44,
          1.74
        ]
      },
      "axis": null
    },
    "y": {
      "type": "quantitative",
      "scale": {
        "domain": [
          -2600,
          47765
        ],
        "reverse": true,
        "nice": false,
        "zero": false
      },
      "axis": null
    }
  },
  "layer": [
    {
      "description": "Ribbons: each link is sampled at 21 points; its top edge eases from the commodity side to the destination side along an S-curve (smoothstep) and its thickness is its value",
      "data": {
        "url": "../data/clean/sankey_links.csv",
        "format": {
          "parse": {
            "usd_m": "number",
            "src_y": "number",
            "tgt_y": "number",
            "pct_of_commodity": "number",
            "pct_of_region": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "familyOf[datum.commodity]",
          "as": "family"
        },
        {
          "calculate": "sequence(0, 21)",
          "as": "step"
        },
        {
          "flatten": [
            "step"
          ]
        },
        {
          "calculate": "datum.step / 20",
          "as": "x"
        },
        {
          "calculate": "datum.src_y + (datum.tgt_y - datum.src_y) * datum.x * datum.x * (3 - 2 * datum.x)",
          "as": "y"
        },
        {
          "calculate": "datum.y + datum.usd_m",
          "as": "y2"
        }
      ],
      "params": [
        {
          "name": "familyPick",
          "select": {
            "type": "point",
            "fields": [
              "family"
            ]
          },
          "bind": "legend"
        },
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "commodity"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "x"
        },
        "y": {
          "field": "y"
        },
        "y2": {
          "field": "y2"
        },
        "detail": [
          {
            "field": "commodity"
          },
          {
            "field": "region"
          }
        ],
        "color": {
          "field": "family",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Meat",
              "Grains, oilseeds & pulses",
              "Dairy, wine & other food"
            ],
            "range": [
              "#c0392b",
              "#bfae1c",
              "#C4C6CB"
            ]
          },
          "legend": {
            "orient": "top",
            "symbolType": "square",
            "columns": 3,
            "labelLimit": 260
          }
        },
        "opacity": {
          "condition": [
            {
              "param": "hover",
              "empty": false,
              "value": 0.85
            },
            {
              "test": "length(data('hover_store')) > 0",
              "value": 0.08
            },
            {
              "test": "datum.commodity === 'Barley' && datum.region === 'China' && length(data('familyPick_store')) === 0",
              "value": 0.85
            },
            {
              "param": "familyPick",
              "value": 0.5
            }
          ],
          "value": 0.08
        },
        "tooltip": [
          {
            "field": "commodity",
            "type": "nominal",
            "title": "Food"
          },
          {
            "field": "region",
            "type": "nominal",
            "title": "Sold to"
          },
          {
            "field": "usd_m",
            "type": "quantitative",
            "title": "Value (US$ million)",
            "format": ",.0f"
          },
          {
            "field": "pct_of_commodity",
            "type": "quantitative",
            "title": "% of this food's exports",
            "format": ".0f"
          },
          {
            "field": "pct_of_region",
            "type": "quantitative",
            "title": "% of what this region buys from us",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "description": "Nodes: commodities on the left (coloured by food family), destinations on the right (neutral)",
      "data": {
        "url": "../data/clean/sankey_nodes.csv",
        "format": {
          "parse": {
            "usd_m": "number",
            "y": "number",
            "y2": "number",
            "share": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.side === 'Commodity' ? familyOf[datum.node] : null",
          "as": "family"
        },
        {
          "calculate": "datum.side === 'Commodity' ? -0.03 : 1",
          "as": "x"
        },
        {
          "calculate": "datum.x + 0.03",
          "as": "x2"
        },
        {
          "calculate": "datum.node + '  US$' + format(datum.usd_m / 1000, '.1f') + ' billion'",
          "as": "label"
        },
        {
          "calculate": "(datum.y + datum.y2) / 2",
          "as": "ymid"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 2
          },
          "encoding": {
            "x": {
              "field": "x"
            },
            "x2": {
              "field": "x2"
            },
            "y": {
              "field": "y"
            },
            "y2": {
              "field": "y2"
            },
            "color": {
              "condition": {
                "test": "datum.side === 'Destination'",
                "value": "#45474C"
              },
              "field": "family",
              "type": "nominal"
            },
            "tooltip": [
              {
                "field": "node",
                "type": "nominal",
                "title": "Group"
              },
              {
                "field": "usd_m",
                "type": "quantitative",
                "title": "Value (US$ million)",
                "format": ",.0f"
              },
              {
                "field": "share",
                "type": "quantitative",
                "title": "% of all food exports",
                "format": ".0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'Commodity'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -8,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#2F3A55"
          },
          "encoding": {
            "x": {
              "field": "x"
            },
            "y": {
              "field": "ymid"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'Destination'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 8,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#2F3A55"
          },
          "encoding": {
            "x": {
              "field": "x2"
            },
            "y": {
              "field": "ymid"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ],
      "encoding": {}
    },
    {
      "description": "Column headings",
      "data": {
        "values": [
          {
            "x": -0.03,
            "t": "WHAT WE SELL",
            "align": "right"
          },
          {
            "x": 1.03,
            "t": "WHO BUYS IT",
            "align": "left"
          }
        ]
      },
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.align === 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "top",
            "fontSize": 12,
            "fontWeight": 700,
            "letterSpacing": 1,
            "color": "#6E6F73"
          },
          "encoding": {
            "x": {
              "field": "x"
            },
            "y": {
              "datum": -2600
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.align === 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 12,
            "fontWeight": 700,
            "letterSpacing": 1,
            "color": "#6E6F73"
          },
          "encoding": {
            "x": {
              "field": "x"
            },
            "y": {
              "datum": -2600
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "description": "Call-out for the story's headline flow: barley to China, placed at the ribbon's midpoint",
      "data": {
        "url": "../data/clean/sankey_links.csv",
        "format": {
          "parse": {
            "usd_m": "number",
            "src_y": "number",
            "tgt_y": "number",
            "pct_of_commodity": "number",
            "pct_of_region": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.commodity === 'Barley' && datum.region === 'China'"
        },
        {
          "calculate": "(datum.src_y + datum.tgt_y) / 2 + datum.usd_m / 2",
          "as": "ymid"
        },
        {
          "calculate": "'Barley to China: ' + format(datum.pct_of_commodity, '.0f') + '% of our barley'",
          "as": "t"
        },
        {
          "calculate": "0.5",
          "as": "x"
        }
      ],
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "ymid",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#2F3A55",
            "stroke": "#ffffff",
            "strokeWidth": 4,
            "strokeJoin": "round",
            "strokeOpacity": 0.9,
            "dy": -14
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#2F3A55",
            "dy": -14
          }
        }
      ]
    }
  ]
}