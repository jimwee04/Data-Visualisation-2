{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "KPI micro-chart: chicken compared with beef food supply per person (kg), 2023.",
  "width": "container",
  "height": 44,
  "data": {
    "url": "../data/clean/fbs_per_person.csv",
    "format": {
      "parse": {
        "year": "number",
        "kg_per_person": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year === 2023 && (datum.food === 'Chicken & poultry' || datum.food === 'Beef')"
    },
    {
      "calculate": "datum.food === 'Beef' ? 'Beef' : 'Chicken'",
      "as": "meat"
    },
    {
      "calculate": "format(datum.kg_per_person, '.0f') + ' kg'",
      "as": "label"
    }
  ],
  "encoding": {
    "y": {
      "field": "meat",
      "type": "nominal",
      "sort": [
        "Chicken",
        "Beef"
      ],
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelColor": "#E7E2DE",
        "labelFontSize": 12,
        "labelPadding": 6
      }
    },
    "x": {
      "field": "kg_per_person",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          72
        ],
        "nice": false
      },
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2,
        "height": {
          "band": 0.72
        }
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.meat === 'Beef'",
            "value": "#E58A80"
          },
          "value": "#7FB0E6"
        },
        "tooltip": [
          {
            "field": "food",
            "title": "Food"
          },
          {
            "field": "kg_per_person",
            "title": "kg per person, 2023",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "color": "#F5F6F3",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ]
}